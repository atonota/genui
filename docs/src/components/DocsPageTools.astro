---
// Concrete page tools: the published source of the catalog entry, repository edit and issue
// links only when PUBLIC_GENUI_REPOSITORY_URL is configured, and copy as Markdown, which
// docs-page.ts reveals once the clipboard is available.
import { sourceHref } from '../pages/source/[...path].txt';
import { repositoryBranch, repositoryUrl } from './docs-page';

interface Props {
  placement: 'rail' | 'article';
}
const { placement } = Astro.props;
const sourcePath = 'docs/src/data/catalog.ts';
const source = sourceHref(sourcePath);
const edit =
  repositoryUrl && repositoryBranch
    ? `${repositoryUrl}/edit/${repositoryBranch}/${sourcePath}`
    : undefined;
---

<div class="docs-page-tools" data-doc-tools={placement}>
  {source && (
    <a href={source}>
      <span data-i18n="View page source">View page source</span>
    </a>
  )}
  {edit && (
    <a href={edit}>
      <span data-i18n="Edit this page">Edit this page</span>
    </a>
  )}
  {repositoryUrl && (
    <a href={`${repositoryUrl}/issues/new`}>
      <span data-i18n="Report an issue">Report an issue</span>
    </a>
  )}
  <button type="button" class="doc-choice" data-doc-copy-markdown hidden>
    <span data-i18n="Copy as Markdown">Copy as Markdown</span>
  </button>
  <p role="status" data-doc-copy-status></p>
</div>
