---
import DocsLayout from '../layouts/DocsLayout.astro';
import DocumentationNav from '../components/DocumentationNav.astro';
import genux from '../data/genux.json';
import colorLicense from '../../../node_modules/@ant-design/colors/LICENSE?raw';
const iconLicenses = Object.entries(genux.icons).map(([key, library]) => ({
  id: key + '-license',
  label: library.label + ' · ' + library.version,
  license: library.license,
}));
const sections = [
  { id: 'outfit-license', label: 'Outfit' },
  ...iconLicenses.map(({ id, label }) => ({ id, label })),
  { id: 'ant-design-colors-license', label: '@ant-design/colors · 8.0.1' },
];
---

<DocsLayout
  title="Third-party licenses"
  description="License information for Outfit and embedded icons."
>
  <h1>
    <span class="page-heading-line" data-i18n="Third-party licenses">
      Third-party licenses
    </span>
  </h1>
  <p class="lead">
    Font, icon and package license notices used by GenUX, with original license texts and source
    references.
  </p>
  <DocumentationNav items={sections} />
  <section
    id="outfit-license"
    class="doc-section"
    data-doc-section="outfit-license"
    aria-labelledby="outfit-license-title"
  >
    <h2 id="outfit-license-title">Outfit</h2>
    <p>
      <span data-i18n="Outfit is distributed under the SIL Open Font License 1.1. The full license text comes from the original genux font source.">
        Outfit is distributed under the SIL Open Font License 1.1. The full license text comes from
        the original genux font source.
      </span>
    </p>
    <a href="https://github.com/Outfitio/Outfit-Fonts/blob/main/OFL.txt">Outfit OFL 1.1</a>
    <pre class="license-text"><code>{genux.outfitLicense}</code></pre>
  </section>
  {iconLicenses.map(({ id, label, license }) => (
    <section id={id} class="doc-section" data-doc-section={id} aria-labelledby={id + '-title'}>
      <h2 id={id + '-title'}>{label}</h2>
      <pre class="license-text"><code>{license}</code></pre>
    </section>
  ))}
  <section
    id="ant-design-colors-license"
    class="doc-section"
    data-doc-section="ant-design-colors-license"
    aria-labelledby="ant-design-colors-license-title"
  >
    <h2 id="ant-design-colors-license-title">@ant-design/colors · 8.0.1</h2>
    <pre class="license-text"><code>{colorLicense}</code></pre>
  </section>
</DocsLayout>
