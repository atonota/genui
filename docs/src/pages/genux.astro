---
import { canonicalUrl } from '../data/url-policy';
const target = '/ai-ui/';
---

<!doctype html>
<html lang="en" data-page-kind="redirect">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>GenUX guide moved</title>
    <link rel="canonical" href={canonicalUrl('/ai-ui/')} />
    <noscript>
      <meta http-equiv="refresh" content={`0; url=${target}`} />
    </noscript>
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
  </head>
  <body>
    <main>
      <h1>GenUX guide moved</h1>
      <p>
        <a href={target}>Read the GenUX guide</a>
      </p>
    </main>
  </body>
</html>
