const featureSheet = workspaceSheets[component.slug];

// Route stylesheets in cascade order. The head links and the generated Astro
// example both read this list, so copied example code loads the route's CSS.
type RouteSheetRule = readonly [included: boolean, file: string, href: string];
const slug = component.slug;
const feedbackRoutes = ['toast', 'alert', 'notification', 'modal', 'popconfirm'];
const identityRoutes = ['data-table', 'collection-views', 'record-workspace'];
const kitRoute = Boolean(featureSheet) || slug === 'record-workspace';
const routeSheetRules: RouteSheetRule[] = [
