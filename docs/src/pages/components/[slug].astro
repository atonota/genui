  [slug === 'drawer', 'genux-drawer-extensions.css', drawerExtensionStyles],
  [
    ['avatar', 'content-patterns', 'badge', 'listy', ...identityRoutes].includes(slug),
    'genux-avatar.css',
    avatarStyles,
  ],
  [feedbackRoutes.includes(slug), 'genux-feedback.css', feedbackStyles],
  [slug === 'date-time', 'genux-date-time.css', dateTimeStyles],
  [Boolean(featureSheet), 'workspace.css', workspaceStyles],
  [Boolean(featureSheet), featureSheet?.file ?? '', featureSheet?.href ?? ''],
  [kitRoute, 'workspace-kit.css', kitStyles],
  [kitRoute, 'kit-forms-fixes.css', kitFormFixes],
  [slug === 'record-workspace', 'workspace.css', workspaceStyles],
  [slug === 'record-workspace', 'workspace-connected.css', connectedStyles],
  [['record-workspace', 'empty-state'].includes(slug), 'kit-collections.css', kitCollectionStyles],
  [slug === 'record-workspace', 'kit-records.css', kitRecordStyles],
  [identityRoutes.includes(slug), 'kit-identity.css', kitIdentityStyles],
  [['media', 'carousel'].includes(slug), 'genux-media.css', mediaStyles],
  [slug === 'media', 'genux-screenshot.css', screenshotStyles],
  [slug === 'content-patterns', 'genux-content-patterns.css', contentPatternStyles],
  [slug === 'carousel', 'genux-carousel.css', carouselStyles],
  [slug === 'upload', 'genux-upload.css', uploadStyles],
  [slug === 'rich-menu', 'genux-rich-menu.css', richMenuStyles],
  [slug === 'chart', 'genux-chart.css', chartStyles],
  [['badge', 'fab'].includes(slug), 'genux-badge.css', badgeStyles],
  [slug === 'fab', 'genux-fab.css', fabStyles],
];
const routeSheets = routeSheetRules
