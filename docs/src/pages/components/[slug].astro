  [true, 'preview-document.css', previewDocumentStyles],
  [true, 'preview-workbench.css', previewWorkbenchStyles],
  [['slider', 'record-workspace'].includes(slug), 'slider.css', sliderStyles],
  [slug === 'button', 'button-catalog.css', buttonCatalogStyles],
  [slug === 'pill', 'pill-catalog.css', pillCatalogStyles],
  [slug === 'card' || kitRoute || feedbackRoutes.includes(slug), 'genux-card.css', genuxCardStyles],
  [slug === 'card', 'card-catalog.css', cardCatalogStyles],
  [
    slug === 'splitter' || component.category === 'Data workspace',
    'genux-splitter.css',
    splitterStyles,
  ],
  [slug === 'splitter', 'splitter-catalog.css', splitterCatalogStyles],
  [slug === 'breadcrumb', 'genux-breadcrumb.css', breadcrumbStyles],
  [slug === 'breadcrumb', 'breadcrumb-catalog.css', breadcrumbCatalogStyles],
  [
    ['pagination', 'record-workspace', 'empty-state'].includes(slug),
    'genux-pagination.css',
    paginationStyles,
  ],
  [slug === 'pagination', 'pagination-catalog.css', paginationCatalogStyles],
  [slug === 'steps', 'genux-steps.css', stepsStyles],
  [slug === 'steps', 'steps-catalog.css', stepsCatalogStyles],
  [slug === 'autocomplete', 'genux-autocomplete.css', autoCompleteStyles],
  [slug === 'autocomplete', 'autocomplete-catalog.css', autoCompleteCatalogStyles],
  [slug === 'cascader', 'genux-cascader.css', cascaderStyles],
  [['listy', 'cascader'].includes(slug), 'genux-listy.css', listyStyles],
  [slug === 'cascader', 'cascader-catalog.css', cascaderCatalogStyles],
  [['dropdown', 'rich-menu'].includes(slug), 'genux-dropdown.css', dropdownStyles],
  [slug === 'dropdown', 'dropdown-catalog.css', dropdownCatalogStyles],
  [
    ['input', 'select', 'checkbox', 'radio', 'switch', 'slider', 'form', 'date-time'].includes(
      slug,
