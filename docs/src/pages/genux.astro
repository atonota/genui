---
import DocsLayout from '../layouts/DocsLayout.astro';
import DocumentationNav from '../components/DocumentationNav.astro';
import {
  GENUX_CARD_CATALOG_ID,
  GENUX_PUBLIC_CATALOG_ID,
  GENUX_COMPONENT_NAMES,
  GENUX_NATIVE_COMPONENT_NAMES,
} from '../genux/contracts';

// Names and counts come from contracts.ts; the input summary mirrors validateComponent in policy.ts.
const nativeNames = new Set<string>(GENUX_NATIVE_COMPONENT_NAMES);
const semanticNames = GENUX_COMPONENT_NAMES.filter(name => !nativeNames.has(name));
const cardNames = new Set<string>(['GenUXEntityCard', 'GenUXMetricCard', 'GenUXPurposeCard']);
const contractOf = (name: string) => {
  if (name === 'GenUXStack')
    return { input: 'Child references and direction', contains: 'Registered components' };
  if (name === 'GenUXText') return { input: 'Text or a /state binding', contains: 'Nothing' };
  if (cardNames.has(name))
    return { input: 'Validated Card model or a /state binding', contains: 'Nothing' };
  if (name === 'GenUXTaskSurface')
    return { input: 'Typed task payload or a /state binding', contains: 'Task blocks' };
  return { input: 'Typed task block payload or a /state binding', contains: 'Nothing' };
};
const lead =
  'GenUX turns a validated semantic description into registered GenUX components. This page documents the code that exists today.';
const pipeline = [
  {
    step: 'Intent',
    detail:
      'A request or recorded stream describes components as JSON commands. It never supplies code, markup, styles or endpoints.',
  },
  {
    step: 'Policy and validation',
    detail:
      'policy.ts validates every component, Card model and task payload; invalid input is rejected before it is published.',
  },
  {
    step: 'Registered component',
    detail:
      'Only a name from GENUX_COMPONENT_NAMES is accepted. Native names resolve through a static, code-owned registry.',
  },
  {
    step: 'Renderer',
    detail:
      'GenUXSurface renders each published surface through a fixed component map and returns user actions to the runtime.',
  },
];
const policy = [
  'Input must be plain JSON with safe identifiers and bounded text. Unknown properties are rejected.',
  'Card models are checked against their purpose: required and purpose-exclusive facets, unique action and field identities, task progress, source time and fact formats.',
  'Data bindings may only use safe identifier paths below /state.',
  'GenUXStack accepts only child references and a direction; GenUXText accepts only text.',
  'Purpose Cards require a model and cannot contain child components.',
  'Task blocks accept a typed payload; only GenUXTaskSurface may contain blocks.',
  'Collections, choices and forms reject duplicate identities, undeclared fields and invalid selections or values.',
];
const renderer = [
  'GenUXSurface registers the panel and public catalogs with Ant Design X Card and renders each surface through a fixed component map.',
  'Models, task payloads, texts and drafts reach components through /state bindings.',
  'Actions stay disabled while a stream is still being received or has not completed successfully.',
  'Each action carries the surface, component, rendered revision and an idempotency key; edits from a stale generation or revision are rejected.',
  'A native adapter that fails to load stays local to its control, without retry or runtime mutation.',
  'Recorded data text is translated; host data text is shown as received.',
];
const boundaries = [
  'No live model is connected. The model endpoint and authentication await an explicit user decision.',
  'Documentation surfaces replay recorded local data. They are not live AI output and do not write to a server.',
  'Create and review actions require native fields that pass the shared field-kit rules.',
  'This page documents existing code only. It adds no runtime components or capabilities.',
];
const sources = [
  {
    path: 'docs/src/genux/contracts.ts',
    role: 'Registered names, catalog identities and runtime contract',
  },
  { path: 'docs/src/genux/policy.ts', role: 'Policy and validation' },
  { path: 'docs/src/genux/native-registry.ts', role: 'Static native definition registry' },
  { path: 'docs/src/genux/native-action-readiness.ts', role: 'Create and review action readiness' },
  { path: 'docs/src/react/genux/GenUXSurface.tsx', role: 'Renderer' },
];
const sections = [
  { id: 'scope', label: 'Scope' },
  { id: 'pipeline', label: 'Pipeline' },
  { id: 'registered-components', label: 'Registered components' },
  { id: 'native-adapters', label: 'Native adapters' },
  { id: 'policy', label: 'Policy and validation' },
  { id: 'renderer', label: 'Renderer' },
  { id: 'boundaries', label: 'Boundaries' },
  { id: 'admission', label: 'Adding components' },
  { id: 'sources', label: 'Sources' },
];
---

<DocsLayout
  title="GenUX"
  description="How GenUX validates semantic intent and renders only registered GenUX components."
  slug="genux"
>
  <p class="eyebrow">
    <span data-i18n="FOUNDATIONS / GENUX">FOUNDATIONS / GENUX</span>
  </p>
  <h1>
    <span class="page-heading-line" data-i18n="Validated intent.">
      Validated intent.
    </span>
    <br />
    <span>
      <span data-i18n="Registered components only.">Registered components only.</span>
    </span>
  </h1>
  <p class="lead">
    <span data-i18n={lead}>{lead}</span>
  </p>
  <DocumentationNav items={sections} />
  <section id="scope" class="doc-section" data-doc-section="scope" aria-labelledby="scope-title">
    <h2 id="scope-title">
      <span data-i18n="Scope">Scope</span>
    </h2>
    <p>
      <span data-i18n="GenUX surfaces serve two audiences with separate catalog identities.">
        GenUX surfaces serve two audiences with separate catalog identities.
      </span>
    </p>
    <ul>
      <li>
        <span data-i18n="Panel catalog:">Panel catalog:</span> <code>{GENUX_CARD_CATALOG_ID}</code>
      </li>
      <li>
        <span data-i18n="Public read-only catalog:">Public read-only catalog:</span>{' '}
        <code>{GENUX_PUBLIC_CATALOG_ID}</code>
      </li>
    </ul>
  </section>
  <section
    id="pipeline"
    class="doc-section"
    data-doc-section="pipeline"
    aria-labelledby="pipeline-title"
  >
    <h2 id="pipeline-title">
      <span data-i18n="Pipeline">Pipeline</span>
    </h2>
    <ol>
      {pipeline.map(item => (
        <li>
          <strong data-i18n={item.step}>{item.step}</strong>:{' '}
          <span data-i18n={item.detail}>{item.detail}</span>
        </li>
      ))}
    </ol>
  </section>
  <section
    id="registered-components"
    class="doc-section"
    data-doc-section="registered-components"
    aria-labelledby="registered-components-title"
  >
    <h2 id="registered-components-title">
      <span data-i18n="Registered components">Registered components</span>
    </h2>
    <p>
      <span data-i18n="Semantic names come from GENUX_COMPONENT_NAMES in contracts.ts, excluding native adapter names.">
        Semantic names come from GENUX_COMPONENT_NAMES in contracts.ts, excluding native adapter
        names.
      </span>
    </p>
    <ul>
      <li>
        <span data-i18n="Semantic names:">Semantic names:</span> {semanticNames.length}
      </li>
      <li>
        <span data-i18n="Native adapter names:">Native adapter names:</span>{' '}
        {GENUX_NATIVE_COMPONENT_NAMES.length}
      </li>
      <li>
        <span data-i18n="All registered names:">All registered names:</span>{' '}
        {GENUX_COMPONENT_NAMES.length}
      </li>
    </ul>
    <div
      class="genux-table-scroll"
      role="region"
      aria-labelledby="registered-components-title"
      tabindex="0"
    >
      <table>
        <thead>
          <tr>
            <th scope="col">
              <span data-i18n="Registered name">Registered name</span>
            </th>
            <th scope="col">
              <span data-i18n="Accepted input">Accepted input</span>
            </th>
            <th scope="col">
              <span data-i18n="May contain">May contain</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {semanticNames.map(name => {
            const contract = contractOf(name);
            return (
              <tr>
                <th scope="row">
                  <code>{name}</code>
                </th>
                <td>
                  <span data-i18n={contract.input}>{contract.input}</span>
                </td>
                <td>
                  <span data-i18n={contract.contains}>{contract.contains}</span>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>
  <section
    id="native-adapters"
    class="doc-section"
    data-doc-section="native-adapters"
    aria-labelledby="native-adapters-title"
  >
    <h2 id="native-adapters-title">
      <span data-i18n="Native adapters">Native adapters</span>
    </h2>
    <p>
      <span data-i18n="Native names select a definition from NATIVE_DEFINITIONS, a static code-owned mapping in native-registry.ts. A model selects a registered name only; it can never register a definition, renderer, endpoint or style.">
        Native names select a definition from NATIVE_DEFINITIONS, a static code-owned mapping in
        native-registry.ts. A model selects a registered name only; it can never register a
        definition, renderer, endpoint or style.
      </span>
    </p>
    <p>
      <span data-i18n="Every native block uses one strict envelope: a title, a native value parsed by its registered definition and an optional action.">
        Every native block uses one strict envelope: a title, a native value parsed by its
        registered definition and an optional action.
      </span>
    </p>
    <ul>
      {GENUX_NATIVE_COMPONENT_NAMES.map(name => (
        <li>
          <code>{name}</code>
        </li>
      ))}
    </ul>
  </section>
  <section id="policy" class="doc-section" data-doc-section="policy" aria-labelledby="policy-title">
    <h2 id="policy-title">
      <span data-i18n="Policy and validation">Policy and validation</span>
    </h2>
    <ul>
      {policy.map(item => (
        <li>
          <span data-i18n={item}>{item}</span>
        </li>
      ))}
    </ul>
  </section>
  <section
    id="renderer"
    class="doc-section"
    data-doc-section="renderer"
    aria-labelledby="renderer-title"
  >
    <h2 id="renderer-title">
      <span data-i18n="Renderer">Renderer</span>
    </h2>
    <ul>
      {renderer.map(item => (
        <li>
          <span data-i18n={item}>{item}</span>
        </li>
      ))}
    </ul>
  </section>
  <section
    id="boundaries"
    class="doc-section"
    data-doc-section="boundaries"
    aria-labelledby="boundaries-title"
  >
    <h2 id="boundaries-title">
      <span data-i18n="Boundaries">Boundaries</span>
    </h2>
    <ul>
      {boundaries.map(item => (
        <li>
          <span data-i18n={item}>{item}</span>
        </li>
      ))}
    </ul>
  </section>
  <section
    id="admission"
    class="doc-section"
    data-doc-section="admission"
    aria-labelledby="admission-title"
  >
    <h2 id="admission-title">
      <span data-i18n="Adding components">Adding components</span>
    </h2>
    <p>
      <span data-i18n="New semantic components and native adapters follow the documentation admission workflow. This page lists registered names; it does not register them.">
        New semantic components and native adapters follow the documentation admission workflow.
        This page lists registered names; it does not register them.
      </span>
    </p>
    <a href="/documentation/#admission">
      <span data-i18n="Admission workflow">Admission workflow</span>
    </a>
  </section>
  <section
    id="sources"
    class="doc-section"
    data-doc-section="sources"
    aria-labelledby="sources-title"
  >
    <h2 id="sources-title">
      <span data-i18n="Sources">Sources</span>
    </h2>
    <ul>
      {sources.map(source => (
        <li>
          <code>{source.path}</code> — <span data-i18n={source.role}>{source.role}</span>
        </li>
      ))}
    </ul>
  </section>
</DocsLayout>

<style>
  /* The table scrolls inside its own container; names never break mid-word. */
  .genux-table-scroll {
    max-inline-size: 100%;
    overflow-x: auto;
  }
  .genux-table-scroll th[scope='row'] {
    white-space: nowrap;
  }
</style>
